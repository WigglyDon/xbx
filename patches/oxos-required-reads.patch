+// Required extents must be complete; the initial header read remains a probe.
+// Functional guard retained from xbx's accepted loader-completeness repair.
+static NTSTATUS XepReadRequired(HANDLE h, PVOID buffer, ULONG length, ULONG offset) {
+    ULONG got = 0;
+    NTSTATUS status = XeReadFile(h, buffer, length, offset, &got);
+    return NT_SUCCESS(status) && got != length ? STATUS_END_OF_FILE : status;
+}
