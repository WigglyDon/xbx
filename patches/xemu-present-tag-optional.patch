+#ifdef __ANDROID__
+/* Tokens identify this run's first seven source bindings, never raw handles.
+ * The render thread alone owns this diagnostic-only table. */
+static unsigned present_tag_source(SurfaceBinding *surface)
+{
+    static SurfaceBinding *sources[7];
+    static unsigned used;
+    for (unsigned i = 0; i < used; i++) {
+        if (sources[i] == surface) {
+            return i;
+        }
+    }
+    if (used < ARRAY_SIZE(sources)) {
+        sources[used] = surface;
+        return used++;
+    }
+    return 7;
+}
+#endif
+
+static void update_uniforms(PGRAPHState *pg, SurfaceBinding *surface,
+                            uint32_t sampled_use)
