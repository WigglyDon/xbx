diff --git a/kernel/src/xe/loader.cpp b/kernel/src/xe/loader.cpp
index 175f662..3c5d9bb 100644
--- a/kernel/src/xe/loader.cpp
+++ b/kernel/src/xe/loader.cpp
@@ -392,6 +392,70 @@ struct LAUNCH_DATA_PAGE {
 };
 static_assert(sizeof(LAUNCH_DATA_PAGE) == 0x1000);
 
+#if defined(XK_XBX_LAUNCH_TRACE)
+extern "C" volatile ULONG KiQuickRebootCount;
+extern volatile ULONG KiLastExceptionVector, KiLastExceptionCode, KiLastExceptionEip;
+static XK_PERSIST ULONG XbxTraceEvents, XbxFirmwareReturns;
+// Diagnostic only: bounded fields, no launch payload or keys. Raw logs stay private.
+extern "C" void XbxTraceLaunchPage(const char *Phase, ULONG Routine, ULONG Caller) {
+    if (XbxTraceEvents++ >= 48)
+        return;
+    auto thread = PsGetCurrentThread();
+    auto page = (LAUNCH_DATA_PAGE *)LaunchDataPage;
+    bool valid = page && (ULONG)page <= 0xFFFFF000 && !((ULONG)page & 4095) && MmIsAddressValid(page) && MmIsAddressValid((PUCHAR)page + 4095);
+    XK_SERIAL("XBX-LAUNCH phase=%s quick=%u return=%u routine=%u caller=%08x thread=%08x page=%08x valid=%u\n",
+              Phase, KiQuickRebootCount, XbxFirmwareReturns, Routine, Caller,
+              (ULONG)thread, (ULONG)page, valid);
+    if (valid) {
+        char path[121];
+        ULONG n = 0;
+        while (n < 120 && page->LaunchPath[n]) {
+            UCHAR ch = page->LaunchPath[n];
+            path[n++] = ch >= 32 && ch < 127 ? ch : '.';
+        }
+        path[n] = 0;
+        bool dashboard = !page->LaunchPath[0]; // destination is dashboard; keep the raw type beside these fields
+        XK_SERIAL("XBX-LAUNCH type=%08x title=%08x flags=%08x dashboard_fields=%u reason=%08x code=%08x path_truncated=%u\n",
+                  page->LaunchDataType, page->TitleId, page->Flags, dashboard,
+                  dashboard ? page->DashboardReason : 0, dashboard ? page->DashboardCode : 0, n == 120);
+        XK_SERIAL("XBX-LAUNCH path=[%s]\n", path);
+    }
+    XK_SERIAL("XBX-LAUNCH load=%08x missing_ordinal=%u exception=%08x exception_code=%08x exception_eip=%08x\n",
+              XeLastLoadStatus, XeLastMissingOrdinal, KiLastExceptionVector,
+              KiLastExceptionCode, KiLastExceptionEip);
+}
+extern volatile ULONG MiVmFailures, MiVmLastFailure[5];
+extern volatile ULONG XbxLinkCount, XbxLinkCaller, XbxLinkStatus;
+extern "C" void XbxTraceFirmwareReturn(ULONG Routine, ULONG Caller, ULONG Frame) {
+    ++XbxFirmwareReturns;
+    XbxTraceLaunchPage("pre-firmware", Routine, Caller);
+    if (XbxFirmwareReturns > 4)
+        return;
+    XK_SERIAL("XBX-STARTUP vm_failures=%u vm_status=%08x vm_base=%08x vm_size=%08x vm_type=%08x vm_protect=%08x link_count=%u link_caller=%08x link_status=%08x\n",
+              MiVmFailures, MiVmLastFailure[0], MiVmLastFailure[1], MiVmLastFailure[2], MiVmLastFailure[3], MiVmLastFailure[4],
+              XbxLinkCount, XbxLinkCaller, XbxLinkStatus);
+    // Only return addresses, never frame arguments/payload. Frames must be aligned,
+    // monotonic and wholly inside the current thread's mapped kernel stack.
+    auto thread = PsGetCurrentThread();
+    ULONG low = (ULONG)thread->Tcb.StackLimit, high = (ULONG)thread->Tcb.StackBase;
+    for (ULONG index = 0; index < 8; index++) {
+        if ((Frame & 3) || Frame < low || Frame > 0xFFFFFFF7 || Frame + 8 > high ||
+            !MmIsAddressValid((PVOID)Frame) || !MmIsAddressValid((PVOID)(Frame + 7)))
+            break;
+        auto words = (volatile ULONG *)Frame;
+        ULONG next = words[0];
+        XK_SERIAL("XBX-RETURN frame=%u pc=%08x\n", index, words[1]);
+        if (next <= Frame)
+            break;
+        Frame = next;
+    }
+}
+#define XBX_PAGE(phase) XbxTraceLaunchPage(phase, 0, 0)
+#else
+#define XBX_PAGE(phase) ((void)0)
+#endif
