+/* A lost Android native window invalidates the surface as well as its
+ * swapchain. Retire dependent work before releasing that native-window ref. */
+static void reset_android_present_surface(PGRAPHState *pg)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    destroy_current_display_image(pg);
+    if (r->present_surface != VK_NULL_HANDLE) {
+        vkDestroySurfaceKHR(r->instance, r->present_surface, NULL);
+        r->present_surface = VK_NULL_HANDLE;
+    }
+}
