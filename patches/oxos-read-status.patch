+// Success records are a separate bounded view, armed only at public title handoff.
+// The existing failure limits remain independent. No paths or payloads are read.
+static ULONG XkReadStatusEnabled;
+void XkBeginReadStatusReport() {
+    __atomic_store_n(&XkReadStatusEnabled, 1u, __ATOMIC_RELAXED);
+}
+static void XkLogReadSuccess(ULONG Kind, NTSTATUS Status, ULONG Bytes, ULONG Flags) {
+    if (Kind < 1 || Kind > 2 || !NT_SUCCESS(Status) ||
+        !__atomic_load_n(&XkReadStatusEnabled, __ATOMIC_RELAXED))
+        return;
+    static ULONG counts[2];
+    ULONG line = __atomic_add_fetch(&counts[Kind - 1], 1u, __ATOMIC_RELAXED);
+    if (line <= 32)
+        XK_SERIAL("xbxio-ok: kind=%lu status=%08lx bytes=%lu flags=%08lx\n", Kind, (ULONG)Status, Bytes, Flags);
+    else if (line == 33)
+        XK_SERIAL("xbxio-ok: kind=%lu success reporting limit reached\n", Kind);
+}
+
 // Bounded public I/O failure reporting only: no paths, payloads, caller PCs or stacks.
 // Separate limits keep optional open probes from hiding a later read error.
 void XkLogIoFailure(ULONG Kind, NTSTATUS Status, ULONG Bytes, ULONG Flags) {
+    XkLogReadSuccess(Kind, Status, Bytes, Flags);
     if (NT_SUCCESS(Status))
         return;
     static ULONG counts[3];
