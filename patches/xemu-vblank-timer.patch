+/* Preserve the qualified nominal 60 Hz mode independently of host
+ * presentation. Programmable/PAL scan timing remains outside this repair.
+ * QEMU_CLOCK_VIRTUAL stops with the VM; missed status events coalesce instead
+ * of replaying a host scheduling backlog. The timer runs under the BQL.
+ */
+#define NV2A_VBLANK_PERIOD_NS (NANOSECONDS_PER_SECOND / 60)
+
+static void nv2a_vblank(void *opaque)
+{
+    NV2AState *d = opaque;
+    d->pcrtc.pending_interrupts |= NV_PCRTC_INTR_0_VBLANK;
+    d->pcrtc.raster = 0;
+    nv2a_update_irq(d);
+    timer_mod(d->vblank_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              NV2A_VBLANK_PERIOD_NS);
+}
+
 static void nv2a_vga_gfx_update(void *opaque)
 {
     VGACommonState *vga = opaque;
     vga->hw_ops->gfx_update(vga);
-
