 void IopDereferenceDevice(PDEVICE_OBJECT DeviceObject);
+
+// Bounded public I/O failure reporting only: no paths, payloads, caller PCs or stacks.
+// Separate limits keep optional open probes from hiding a later read error.
+void XkLogIoFailure(ULONG Kind, NTSTATUS Status, ULONG Bytes, ULONG Flags) {
+    if (NT_SUCCESS(Status))
+        return;
+    static ULONG counts[3];
+    ULONG line = __atomic_add_fetch(&counts[Kind], 1u, __ATOMIC_RELAXED);
+    if (line <= 32)
+        XK_SERIAL("xbxio: kind=%lu status=%08lx bytes=%lu flags=%08lx\n", Kind, (ULONG)Status, Bytes, Flags);
+    else if (line == 33)
+        XK_SERIAL("xbxio: kind=%lu failure reporting limit reached\n", Kind);
+}
 
