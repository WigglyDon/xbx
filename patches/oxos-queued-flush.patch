 static void NTAPI IdexDiskTimeout() { IdexDiskFinishIo(); }
 
+// Flush is a queued non-data command. Waiting for its interrupt lets the
+// scheduler and the asynchronous backing store make progress; a short spin at
+// interrupt IRQL neither serializes competing requests nor proves durability.
+static void NTAPI IdexDiskFinishFlush() {
+    PIRP irp = IdexChannelObject.CurrentIrp;
+    if (!irp)
+        return;
+    UCHAR bm, ata = IdexGetCompletionStatus(&bm);
+    IdexDiskCompleteIrp(irp, ((ata & (IDE_STATUS_ERR | IDE_STATUS_DF)) || (bm & 2))
+                                 ? STATUS_IO_DEVICE_ERROR : STATUS_SUCCESS);
+}
+
+static void IdexDiskStartFlush(PIRP Irp) {
+    PIDE_CHANNEL_OBJECT ch = &IdexChannelObject;
+    ch->FinishIoRoutine = IdexDiskFinishFlush;
+    ch->TimeoutExpiredRoutine = IdexDiskFinishFlush;
+    KIRQL old = KfRaiseIrql(ch->InterruptIrql);
+    outb(IDE_DRIVE, 0xE0);
+    if (!IdexWaitForStatus(IDE_STATUS_BSY | IDE_STATUS_DRDY, IDE_STATUS_DRDY, 1000000)) {
+        KfLowerIrql(old);
+        IdexDiskCompleteIrp(Irp, STATUS_IO_DEVICE_ERROR);
+        return;
+    }
+    outb(IDE_BM_COMMAND, 0);
+    outb(IDE_BM_STATUS, inb(IDE_BM_STATUS) | 6);
+    ch->Timeout = 30;
+    ch->ExpectingBusMasterInterrupt = TRUE; // the channel ISR recognizes this non-DMA command
+    outb(IDE_COMMAND, 0xE7); // FLUSH CACHE
+    KfLowerIrql(old);
+}
+
