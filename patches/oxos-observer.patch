+// Required extents must not promote a successful EOF-clipped read to a loaded
+// image. The initial header probe remains a probe, not an exact 4 KiB extent.
+struct XBX_IMAGE_READS {
+    ULONG HeaderRequired, HeaderCompleted, ExtentsRequired, ExtentsCompleted;
+    ULONGLONG RawRequired, RawCompleted;
+    ULONG ShortReads, IoFailures, Preloads, Loaded, Ready, Matches, Mismatches, Unusable;
+};
+static NTSTATUS XepReadRequired(HANDLE h, PVOID buffer, ULONG length, ULONG offset, ULONG *completed,
+                               XBX_IMAGE_READS *reads) {
+    ULONG got = 0;
+    NTSTATUS status = XeReadFile(h, buffer, length, offset, &got);
+    *completed = got;
+    if (NT_SUCCESS(status) && got == length) {
+        reads->ExtentsCompleted++;
+        return status;
+    }
+    if (NT_SUCCESS(status) || status == STATUS_END_OF_FILE) {
+        reads->ShortReads++;
+        return STATUS_END_OF_FILE;
+    }
+    reads->IoFailures++;
+    return status;
+}
+
+static void XepSectionDigest(XBE_SECTION_HEADER *s, UCHAR *digest) {
+    UCHAR ctx[116];
+    ULONG raw = s->SizeOfRawData;
+    XcSHAInit(ctx);
+    XcSHAUpdate(ctx, (PUCHAR)&raw, 4);
+    XcSHAUpdate(ctx, (PUCHAR)s->VirtualAddress, raw);
+    XcSHAFinal(ctx, digest);
+}
+
+static void XepAuditPreloads(XBE_SECTION_HEADER *sections, ULONG count, XBX_IMAGE_READS *reads) {
+    // Recheck after every preload has finished, before thunk resolution mutates
+    // raw data. A successful earlier per-section hash is not this boundary.
+    reads->Ready = 1;
+    for (ULONG i = 0; i < count; i++) {
+        auto s = &sections[i];
+        if (!(s->Flags & XBE_SECTION_PRELOAD) || !s->SizeOfRawData)
+            continue;
+        bool zero = true, ones = true;
+        for (ULONG j = 0; j < 20; j++) {
+            zero &= s->SectionDigest[j] == 0;
+            ones &= s->SectionDigest[j] == 0xFF;
+        }
+        if (zero || ones) {
+            reads->Unusable++;
+            continue;
+        }
+        UCHAR digest[20];
+        XepSectionDigest(s, digest);
+        bool match = true;
+        for (ULONG j = 0; j < 20; j++)
+            match &= digest[j] == s->SectionDigest[j];
+        if (match)
+            reads->Matches++;
+        else
+            reads->Mismatches++;
+    }
+}
+
+XK_PERSIST ULONG XbxImageReports;
+static void XepReportImage(NTSTATUS status, const XBX_IMAGE_READS &r) {
+    if (XbxImageReports >= 8)
+        return;
+    ULONG attempt = XbxImageReports + 1;
+    XbxImageReports = attempt;
+    XK_SERIAL("XBX-IMAGE attempt=%u status=%08x hdr_req=%u hdr_done=%u raw_req=%llu raw_done=%llu ext_req=%u ext_done=%u short=%u io_fail=%u\n",
+              attempt, (ULONG)status, r.HeaderRequired, r.HeaderCompleted, r.RawRequired, r.RawCompleted,
+              r.ExtentsRequired, r.ExtentsCompleted, r.ShortReads, r.IoFailures);
+    XK_SERIAL("XBX-INTEGRITY attempt=%u preloads=%u loaded=%u ready=%u match=%u mismatch=%u unusable=%u\n",
+              attempt, r.Preloads, r.Loaded, r.Ready, r.Matches, r.Mismatches, r.Unusable);
+}
