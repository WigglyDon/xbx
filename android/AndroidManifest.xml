<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.machinerhythm.xbx">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <application android:label="xbx qualification" android:allowBackup="false" android:debuggable="true"
    android:enableOnBackInvokedCallback="false"
    android:hasCode="true" android:extractNativeLibs="true"
    android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
    <activity android:name=".XbxActivity" android:exported="true" android:process=":engine"
      android:screenOrientation="sensorLandscape"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
      android:hardwareAccelerated="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name=".XbxReturnActivity" android:exported="false" android:process=":engine_return"
      android:screenOrientation="sensorLandscape"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
      android:hardwareAccelerated="true" />
  </application>
</manifest>
